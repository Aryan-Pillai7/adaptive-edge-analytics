# ---------------------------------------------------------------------------
# adaptive-edge-analytics — local configuration
#
#   cp .env.example .env
#
# Every value here has a working default that points at a freshly started
# `adaptive-edge-otel` stack. You should be able to run the job without editing a
# single line.
# ---------------------------------------------------------------------------

# --- Hot tier: where raw data is read from ---------------------------------
# All three are reached over the host's published ports. Tempo included — its QUERY
# API is published on 3200; only its OTLP ingest ports are withheld, because those
# would collide with the Collector, which is the sole intended telemetry ingress.
VICTORIAMETRICS_URL=http://localhost:8428
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# --- Cold tier: where rollups are written ----------------------------------
# Rollups are dual-written: back into VictoriaMetrics/Loki so they stay queryable in
# the tools already running, AND to local Parquet as the durable cheap archive.
# Both paths are generated data and are gitignored.
PARQUET_ROOT=./data/cold
STATE_DIR=./.rollup-state

# --- The hot/cold boundary -------------------------------------------------
# How long after a time bucket closes before it is considered SEALED and safe to roll
# up. Raising these costs freshness; lowering them risks rolling up a window the
# backend has not finished making queryable, which produces an empty result that is
# indistinguishable from a genuinely quiet hour.
#
# These are per-signal because the buffers differ by an order of magnitude:
#
#   metrics  SDK export 10s + Collector batch 5s + VM latencyOffset 30s
GRACE_METRICS_SECONDS=120
#   logs     ...plus Loki chunk_idle_period 2m / max_chunk_age 5m
GRACE_LOGS_SECONDS=600
#   traces   ...plus Tempo max_block_duration 5m + complete_block_timeout 5m
GRACE_TRACES_SECONDS=900

# How far back a run reaches when there is no checkpoint yet (first run, or after a
# reset). Bounded so a cold start cannot try to scan every backend's full retention
# window in one pass. Use `edge-rollup backfill` for anything deliberately older.
MAX_BACKFILL_HOURS=24

# --- HTTP ------------------------------------------------------------------
# Generous: Tempo trace rollups fan out into per-trace fetches, which is the slowest
# read path in the job by a wide margin.
HTTP_TIMEOUT_SECONDS=30
